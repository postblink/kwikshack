# Drizzle
DATABASE_URL=./data/kwikshack.db
# Required in production for POST /api/builds and POST /api/uploads.
# Local `vite dev` remains open when this is unset.
# Use a long random value and share it only through the builder invitation.
#KWIKSHACK_SUBMIT_KEY=change-me

# Adapter-node request ceiling. Production entrypoint defaults to 6M; endpoint
# checks separately cap build JSON at 1MB and image files at 5MB.
#BODY_SIZE_LIMIT=6M

# --- Battle.net sign-in -------------------------------------------------------
# Optional. When BNET_CLIENT_ID/BNET_CLIENT_SECRET/BNET_REDIRECT_URI are unset,
# Battle.net sign-in is disabled and every other surface (including the
# invitation-key submission pilot) works exactly as before.
#
# Create the client at https://develop.battle.net/access/clients and register the
# redirect URI there. Blizzard requires https; http://localhost is tolerated only
# in local dev. See docs/battlenet-identity.md.
#BNET_CLIENT_ID=
#BNET_CLIENT_SECRET=
#BNET_REDIRECT_URI=https://kwikshack.com/auth/battlenet/callback

# OAuth regions are us | eu | apac | cn. API host regions are us | eu | kr | tw | cn.
# They are different sets — Blizzard folded kr/tw into apac for OAuth only.
# BNET_REGION seeds both; override either individually.
#BNET_REGION=us
#BNET_OAUTH_REGION=us
#BNET_API_REGION=us

# Battle.net account ids (the `sub` from /userinfo) permitted to index blueprints
# and review claims. Comma-separated. Empty means nobody — the admin routes fail
# closed rather than promoting the first account that signs in.
#KWIKSHACK_ADMIN_BNET_SUBS=

# Set to 0 to skip the automatic pre-migration database backup (CI/ephemeral only).
#KWIKSHACK_MIGRATE_BACKUP=1

# --- Scheduled jobs -----------------------------------------------------------
# Retention runs automatically in-process every 6 hours; no configuration needed.
# `pnpm maintenance` is the operator/cron path. See docs/retention.md.
#
# The canonical decor catalog is imported by `pnpm decor:sync`, which reuses
# BNET_CLIENT_ID / BNET_CLIENT_SECRET above (client credentials — no user is
# involved). Run it at least weekly; canonical rows are deleted at the 30-day
# Blizzard retention limit and the site falls back to its legacy catalog.
#
# Blizzard does not publish the decor response schema — run `pnpm decor:probe`
# first to confirm the field mapping before the first real import.
